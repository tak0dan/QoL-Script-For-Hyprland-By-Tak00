[Unit]
Description=tak0-layout: per-window keyboard layouts for Hyprland that learn your habits
Documentation=https://github.com/tak0dan/QoL-Script-For-Hyprland-By-Tak00/tree/main/layout-tracker

[Service]
Type=simple
ExecStart=%h/.local/bin/tak0-layout daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
